# Server Environment Variables Example
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend URL (Required for Password Reset links sent via email)
CLIENT_URL=https://your-frontend-app.vercel.app

# Email Service Setup (Nodemailer / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AI Assistance (Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# Google Auth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-service.onrender.com/api/auth/google/callback
